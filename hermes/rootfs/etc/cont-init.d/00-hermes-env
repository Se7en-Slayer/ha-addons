#!/command/with-contenv sh
# Write API keys from the add-on's Configuration tab into $HERMES_HOME/.env.
#
# WHY THIS EXISTS
#
# An add-on's /data is reachable by nothing but that add-on, and this box has
# no SSH or Terminal add-on and no docker socket - so there is no shell route
# to edit .env. The alternatives were pasting a key into an agent session whose
# transcript syncs off-device, or committing it to git. Both are leaks; one of
# them already happened on 2026-09-19.
#
# Supervisor stores `password`-typed options in the add-on's options.json,
# masked in the UI, outside git, and included in add-on backups. This script is
# the bridge from there into the .env Hermes actually reads. Rotation becomes a
# form field and a restart.
#
# VALUES ARE NEVER LOGGED. Only variable NAMES are printed. A check that
# reports the presence of a secret must have no branch that can emit it.
#
# Empty options are ignored rather than blanking an existing value, so setting
# one key does not clear the others.
#
# with-contenv, not plain sh: cont-init scripts otherwise do not see
# HERMES_HOME and would write to the upstream default /opt/data.

set -eu

HERMES_HOME="${HERMES_HOME:-/opt/data}"
OPTIONS=/data/options.json

[ -f "$OPTIONS" ] || { echo "[hermes-env] no options.json; nothing to do"; exit 0; }

PY_BIN=""
for c in /usr/bin/python3 /usr/local/bin/python3 /opt/hermes/.venv/bin/python; do
    [ -x "$c" ] && PY_BIN="$c" && break
done
[ -n "$PY_BIN" ] || { echo "[hermes-env] no python interpreter found; skipping" >&2; exit 0; }

"$PY_BIN" - "$OPTIONS" "$HERMES_HOME/.env" <<'PY'
import json, os, re, sys

opts_path, env_path = sys.argv[1], sys.argv[2]

# add-on option name -> environment variable Hermes reads
MAP = {
    "gemini_api_key":     "GEMINI_API_KEY",
    "anthropic_api_key":  "ANTHROPIC_API_KEY",
    "openai_api_key":     "OPENAI_API_KEY",
    "telegram_bot_token": "TELEGRAM_BOT_TOKEN",
    # GITHUB_TOKEN, not GIT_HUB_TOKEN: the underscored spelling that was in
    # .env appears nowhere in the Hermes codebase, so it was never read.
    "github_token":       "GITHUB_TOKEN",
}

try:
    opts = json.load(open(opts_path, encoding="utf-8"))
except Exception as err:
    print(f"[hermes-env] could not read options.json: {type(err).__name__}", file=sys.stderr)
    raise SystemExit(0)

wanted = {}
for opt_name, env_name in MAP.items():
    val = opts.get(opt_name)
    if isinstance(val, str):
        # .strip() is load-bearing: a key pasted with a trailing space or
        # newline authenticates nowhere, and the failure is a bare 401 with
        # nothing to point at. That exact shape cost an afternoon.
        val = val.strip()
        if val:
            wanted[env_name] = val

if not wanted:
    print("[hermes-env] no key options set; .env left untouched")
    raise SystemExit(0)

existing = []
if os.path.exists(env_path):
    existing = open(env_path, encoding="utf-8", errors="replace").read().splitlines()

out, seen = [], set()
for line in existing:
    m = re.match(r"\s*([A-Za-z_][A-Za-z0-9_]*)\s*=", line)
    name = m.group(1) if m else None
    if name in wanted:
        out.append(f"{name}={wanted[name]}")
        seen.add(name)
    else:
        out.append(line)

for name, val in wanted.items():
    if name not in seen:
        out.append(f"{name}={val}")

with open(env_path, "w", encoding="utf-8") as fh:
    fh.write("\n".join(out).rstrip("\n") + "\n")

# NAMES AND FINGERPRINTS ONLY - never values.
#
# The fingerprint exists because an agent reading Supervisor's stored options
# is one hop from what Hermes actually reads, and a check that reads the wrong
# file reports confidently on nothing. This line is emitted from inside the
# container, from the exact bytes written to .env, so it is the live answer.
#
# Recipe, so it can be reproduced by hand:
#     sha256( value.strip().encode("utf-8") ).hexdigest()[:12]
# Stripped first, because that is what gets written. Shell equivalent:
#     printf %s "$VALUE" | sha256sum | cut -c1-12
# printf %s, not echo: echo appends a newline and changes the hash.
import hashlib

print("[hermes-env] set from add-on options:")
for name in sorted(wanted):
    fp = hashlib.sha256(wanted[name].encode("utf-8")).hexdigest()[:12]
    print(f"[hermes-env]   {name} sha256:{fp}")
PY

chown hermes:hermes "$HERMES_HOME/.env" 2>/dev/null || true
chmod 600 "$HERMES_HOME/.env" 2>/dev/null || true

# --- config.yaml from /share, if the operator has put one there ---
#
# Same shape as the .env bridge above: a file the operator can write becomes
# the source of truth, copied in at start. Absent source = no change, so this
# is inert until someone opts in by creating the file.
#
# It OVERWRITES $HERMES_HOME/config.yaml on every start, which is the point -
# the file in /share is declarative. Any edit Hermes makes to its own config
# is replaced at the next restart. That is the same trade as the .env bridge
# and it needs saying out loud, because the alternative failure - an edit that
# survives until a restart and then silently vanishes - is much worse to
# debug. It cost an evening once already.
SHARED_CONFIG=/share/hermes/config.yaml

if [ -r "$SHARED_CONFIG" ]; then
    "$PY_BIN" - "$SHARED_CONFIG" "$HERMES_HOME/config.yaml" <<'PY'
import hashlib, os, shutil, sys

overlay_path, live_path = sys.argv[1], sys.argv[2]

try:
    import yaml
except ImportError:
    print("[hermes-env] WARNING: PyYAML unavailable; overlay NOT applied", file=sys.stderr)
    raise SystemExit(0)

def merge(base, over):
    """Deep-merge `over` onto `base`. Scalars and lists replace; dicts recurse.

    An explicit null in the overlay DELETES the key. A plain deep merge can
    only add or replace, which is not enough here: pinning an auxiliary task
    to `provider: main` while its old `model:` line survives leaves the task
    ambiguously pointed at the model it was supposed to stop using. Writing

        auxiliary:
          approval:
            provider: main
            model: null        # remove, do not override

    removes it. `~` and an empty value are the same thing in YAML, so a key
    you merely wanted to blank must be given an explicit "" instead.
    """
    if not isinstance(base, dict) or not isinstance(over, dict):
        return over
    out = dict(base)
    for k, v in over.items():
        if v is None:
            out.pop(k, None)
        else:
            out[k] = merge(base.get(k), v) if k in base else v
    return out

try:
    overlay = yaml.safe_load(open(overlay_path, encoding="utf-8")) or {}
except Exception as err:
    print(f"[hermes-env] WARNING: overlay is not valid YAML ({type(err).__name__}); "
          "live config left untouched", file=sys.stderr)
    raise SystemExit(0)

if not isinstance(overlay, dict):
    print("[hermes-env] WARNING: overlay is not a mapping; live config left untouched",
          file=sys.stderr)
    raise SystemExit(0)

try:
    live = yaml.safe_load(open(live_path, encoding="utf-8")) or {} if os.path.exists(live_path) else {}
except Exception as err:
    print(f"[hermes-env] WARNING: live config unreadable ({type(err).__name__}); "
          "overlay NOT applied", file=sys.stderr)
    raise SystemExit(0)

# Keep one .bak so a bad overlay is recoverable without the backup system.
if os.path.exists(live_path):
    shutil.copy2(live_path, live_path + ".bak")

merged = merge(live, overlay)
with open(live_path, "w", encoding="utf-8") as fh:
    yaml.safe_dump(merged, fh, sort_keys=False, default_flow_style=False)

fp = hashlib.sha256(open(overlay_path, "rb").read()).hexdigest()[:12]
print(f"[hermes-env] overlay merged from {overlay_path} "
      f"sha256:{fp} ({len(overlay)} top-level keys)")
PY
    chown hermes:hermes "$HERMES_HOME/config.yaml" 2>/dev/null || true
    chmod 600 "$HERMES_HOME/config.yaml" 2>/dev/null || true
else
    echo "[hermes-env] no $SHARED_CONFIG; leaving Hermes's own config.yaml alone"
fi
